{
  "name": "skatteabc-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:db:setup && npm run dev:app",
    "dev:app": "next dev",
    "dev:db:setup": "podman-compose -f db-postgres/podman-compose.yml up -d && echo 'Waiting for PostgreSQL...' && sleep 1 && npx prisma migrate dev && psql 'postgresql://postgres:devpassword@localhost:5433/ask_me_skattabc_dev' -f db-postgres/init-scripts/init.sql && echo 'Database ready with test data!'",
    "dev:db:stop": "podman-compose -f db-postgres/podman-compose.yml down",
    "postdev": "npm run dev:db:stop",
    "debug": "NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:db": "npm run test:db:setup && npm run test:db:run && npm run test:db:teardown",
    "test:db:setup": "podman-compose -f db-postgres/podman-compose.test.yml up -d && echo 'Waiting for test PostgreSQL...' && sleep 3 && DATABASE_URL='postgresql://postgres:testpassword@localhost:5434/ask_me_skattabc_test' npx prisma migrate deploy",
    "test:db:run": "jest --config=./jest.integration.config.js",
    "test:db:teardown": "podman-compose -f db-postgres/podman-compose.test.yml down -v --remove-orphans",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.13.1",
    "@prisma/client": "^5.15.0",
    "dompurify": "^3.1.1",
    "elasticdump": "^6.124.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "llamaindex": "^0.2.10",
    "next": "14.2.2",
    "next-auth": "^4.24.7",
    "prisma": "^5.15.0",
    "react": "^18",
    "react-csv": "^2.2.2",
    "react-dom": "^18",
    "react-markdown": "^9.0.1",
    "tiktoken": "^1.0.15"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.5.7",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-csv": "^1.1.10",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.19",
    "daisyui": "^4.10.2",
    "dotenv": "^17.2.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.5",
    "node-loader": "^2.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "dockerfile": {
    "secrets": [
      "ELASTICSEARCH_URL",
      "OPENAI_API_KEY",
      "ELASTIC_PASSWORD",
      "DATABASE_URL"
    ]
  }
}
