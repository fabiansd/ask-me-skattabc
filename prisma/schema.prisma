generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model flyway_schema_history {
  installed_rank Int      @id(map: "flyway_schema_history_pk")
  version        String?  @db.VarChar(50)
  description    String   @db.VarChar(200)
  type           String   @db.VarChar(20)
  script         String   @db.VarChar(1000)
  checksum       Int?
  installed_by   String   @db.VarChar(100)
  installed_on   DateTime @default(now()) @db.Timestamp(6)
  execution_time Int
  success        Boolean

  @@index([success], map: "flyway_schema_history_s_idx")
}

model conversations {
  conversation_id Int             @id @default(autoincrement())
  user_id         Int
  title           String?         @db.VarChar(255)
  created_at      DateTime        @default(now()) @db.Timestamp(6)
  updated_at      DateTime        @default(now()) @db.Timestamp(6)
  users           users           @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  messages        messages[]
  query_history   query_history[]

  @@index([user_id], map: "index_conversations_user_id")
}

model messages {
  message_id      Int           @id @default(autoincrement())
  conversation_id Int
  role            String        @db.VarChar(20)
  content         String
  tags            String[]
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  conversation    conversations @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id], map: "index_messages_conversation_id")
}

model query_history {
  history_id      Int            @id @default(autoincrement())
  user_id         Int
  question        String
  answer          String
  feedback        Boolean?
  created_at      DateTime?      @default(now()) @db.Timestamp(6)
  conversation_id Int?
  conversation    conversations? @relation(fields: [conversation_id], references: [conversation_id], onUpdate: NoAction)
  users           users          @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "index_user_chat_history")
  @@index([conversation_id], map: "index_query_history_conversation_id")
}

model user_feedback {
  feedback_id        Int       @id @default(autoincrement())
  user_id            Int
  desired_features   String?
  happiness_feedback String?
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  users              users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  user_id       Int             @id @default(autoincrement())
  username      String          @unique @db.VarChar(50)
  email         String?         @unique @db.VarChar(255)
  auth_provider String          @default("default") @db.VarChar(20)
  google_id     String?         @unique @db.VarChar(255)
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  query_count   Int             @default(0)
  conversations conversations[]
  query_history query_history[]
  user_feedback user_feedback[]
}
